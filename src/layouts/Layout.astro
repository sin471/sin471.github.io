---
import '../styles/global.css';
import Header from '@/components/layout/Header.astro';
import BubbleBackground from '@/components/layout/BubbleBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "sin471's portfolio",
  description = "A portfolio website about sin471.",
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="ja" data-theme="sin471" style="overflow-x: hidden;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="sin471" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Material+Symbols+Outlined&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-base-200 text-base-content font-mono antialiased selection:bg-primary">
    <BubbleBackground />
    <Header pathname={pathname}>
      <div class="relative z-10">
        <slot />
      </div>
    </Header>
  </body>
</html>
