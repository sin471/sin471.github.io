---
import type { Activity } from '@/types';

interface Props {
  activity: Activity;
}
const { activity } = Astro.props;
const isAtCoder = activity.title === "AtCoder Rating";
---

<div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-neutral transition-all">
  {activity.imageUrl && (
    <figure class="overflow-hidden h-48 bg-base-200">
      <img src={activity.imageUrl} alt={activity.title} class="w-full h-full object-cover" />
    </figure>
  )}

  <div class="card-body gap-3">
    <div class="flex items-start justify-between gap-2">
      <h2 class="card-title text-lg">{activity.title}</h2>
      {activity.externalUrl && (
        <a href={activity.externalUrl} target="_blank" rel="noopener noreferrer"
          class="btn btn-ghost btn-xs gap-1.5 shrink-0">
          <span class="material-symbols-outlined text-sm leading-none">open_in_new</span>
          Visit
        </a>
      )}
    </div>

    {isAtCoder ? (
      <a href="https://atcoder.jp/users/sin471" target="_blank" rel="noopener noreferrer">
        <img
          src="https://img.shields.io/endpoint?url=https%3A%2F%2Fatcoder-badges.now.sh%2Fapi%2Fatcoder%2Fjson%2Fsin471"
          alt="AtCoder Rating"
          class="h-5"
        />
      </a>
    ) : activity.subtitle ? (
      <p class="text-base text-base-content">{activity.subtitle}</p>
    ) : null}

    {Array.isArray(activity.description) ? (
      <ul class="space-y-1.5 text-base text-base-content">
        {activity.description.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-accent-content mt-0.5">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-base text-base-content">{activity.description}</p>
    )}
  </div>
</div>
