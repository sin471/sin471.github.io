---
import type { Work } from '@/types';

interface Props {
  work: Work;
}
const { work } = Astro.props;
---

<div class="bg-slate-900/40 border border-slate-800 rounded-2xl overflow-hidden hover:border-blue-500/30 hover:shadow-lg hover:shadow-blue-500/10 transition-all">
  {work.imageUrl && (
    <div class="w-full h-48 bg-slate-800/50 overflow-hidden">
      <img
        src={work.imageUrl}
        alt={work.title}
        class="w-full h-full object-cover"
      />
    </div>
  )}

  <div class="p-6">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3 flex-wrap">
        <h3 class="text-xl font-bold text-white italic">{work.title}</h3>
        {work.tags?.map((tag) => (
          <span class="text-[10px] bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded border border-blue-500/20">
            {tag}
          </span>
        ))}
      </div>
      {work.githubUrl && (
        <a
          href={work.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-xs text-slate-300 hover:text-blue-400 transition-colors shrink-0"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
      )}
    </div>

    <div class="space-y-4">
      <ul class="space-y-2 text-sm text-slate-300">
        {work.description.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-blue-400 mt-1">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div>
        <p class="text-[10px] text-blue-400/80 font-bold uppercase tracking-wider mb-2">Tech Stack</p>
        <div class="flex flex-wrap gap-2">
          {work.techStack.map((tech) => (
            <span class="text-xs px-2 py-1 bg-slate-800/50 rounded border border-slate-700/30 text-slate-300">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
