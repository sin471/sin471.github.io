---
// トップページの海中シーン（マンタ・プランクトン・小魚）を Canvas で描く
// 詳細な挙動とイースターエッグは src/scripts/ocean/aquarium.ts を参照
---

<canvas
  id="manta-canvas"
  class="fixed inset-0 z-[5] pointer-events-none"
  aria-hidden="true"
></canvas>

<script>
  import { installPageEasterEggs, startAquarium } from '@/scripts/ocean/aquarium'
  import { prefersReducedMotion } from '@/scripts/ocean/shared'

  const canvas = document.getElementById('manta-canvas') as HTMLCanvasElement | null
  if (canvas) {
    startAquarium(canvas, { reducedMotion: prefersReducedMotion() })
    installPageEasterEggs()
  }
</script>
