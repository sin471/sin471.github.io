---
interface Props {
  icon: string;
  title: string;
  color?: 'blue' | 'green' | 'yellow' | 'slate' | 'indigo';
  border?: boolean;
}

const { icon, title, color = 'slate', border = false } = Astro.props;

const colorClasses: Record<string, string> = {
  blue: 'text-blue-400',
  green: 'text-green-400',
  yellow: 'text-yellow-400',
  slate: 'text-slate-300',
  indigo: 'text-indigo-400',
};

const borderClass = border ? 'pb-2 border-b border-slate-900' : '';
---

<h2 class={`text-xs font-bold tracking-[0.3em] ${colorClasses[color]} uppercase mb-8 flex items-center gap-2 ${borderClass}`}>
  <span class="material-symbols-outlined text-sm leading-none">{icon}</span>
  {title}
</h2>
