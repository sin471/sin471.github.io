---
interface Props {
  icon: string;
  title: string;
  color?: 'blue' | 'green' | 'yellow' | 'slate' | 'indigo';
  border?: boolean;
}

const { icon, title, border = false } = Astro.props;

const borderClass = border ? 'pb-2 border-b border-base-300' : '';
---

<h2 class={`text-sm font-bold tracking-[0.3em] text-base-content uppercase mb-8 flex items-center gap-2 ${borderClass}`}>
  <span class="material-symbols-outlined leading-none">{icon}</span>
  {title}
</h2>
