---
import type { Skill } from '@/types';
import StarRating from './StarRating.astro';

interface Props {
  skill: Skill;
}
const { skill } = Astro.props;
---

<div class="card card-side bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-all p-4 gap-4">
  <div class="w-12 h-12 shrink-0 bg-base-200 rounded-xl flex items-center justify-center p-2 border border-base-300">
    <img
      src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${skill.icon}/${skill.icon}-original.svg`}
      alt={skill.name}
      class="w-full h-full object-contain"
      onerror="this.src='https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg'"
    />
  </div>
  <div class="flex-1 min-w-0 space-y-1.5">
    <div class="flex justify-between items-baseline gap-2">
      <h3 class="font-bold text-base-content text-lg leading-none">{skill.name}</h3>
      <span class="text-xs text-base-content font-mono shrink-0">{skill.years} Exp.</span>
    </div>
    <div>
      <span class="text-xs text-primary font-bold uppercase tracking-tight">Related Tech </span>
      <span class="text-sm text-base-content block">{skill.detail}</span>
    </div>
    <StarRating level={skill.level} />
  </div>
</div>
