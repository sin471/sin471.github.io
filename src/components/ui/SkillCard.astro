---
import type { Skill } from '@/types';
import StarRating from './StarRating.astro';

interface Props {
  skill: Skill;
}
const { skill } = Astro.props;
---

<div class="flex items-center gap-6 p-5 bg-slate-900/40 rounded-2xl border border-slate-800/60">
  <div class="w-14 h-14 shrink-0 bg-slate-800/50 rounded-xl flex items-center justify-center p-2.5 border border-slate-700/30">
    <img
      src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${skill.icon}/${skill.icon}-original.svg`}
      alt={skill.name}
      class="w-full h-full object-contain shadow-sm"
      onerror="this.src='https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg'"
    />
  </div>
  <div class="grow space-y-1.5 min-w-0">
    <div class="flex justify-between items-end">
      <h4 class="font-bold text-white text-lg leading-none">{skill.name}</h4>
      <span class="text-[10px] text-slate-300 font-mono tracking-tighter">{skill.years} Experience</span>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="text-[10px] text-blue-400/80 font-bold uppercase tracking-tighter">Related Tech</span>
      <p class="text-xs text-slate-200 leading-tight truncate">{skill.detail}</p>
    </div>
    <div class="pt-1">
      <StarRating level={skill.level} />
    </div>
  </div>
</div>
