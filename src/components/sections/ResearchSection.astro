---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { academicHistory } from '@/data/academic';
---

<section>
  <SectionHeader icon="science" title="Research" color="yellow" />
  <ul class="timeline timeline-vertical timeline-compact">
    {academicHistory.map((item, i) => (
      <li>
        {i > 0 && <hr />}
        <div class="timeline-start text-xs font-mono text-base-content/50 uppercase tracking-wider whitespace-nowrap">
          {item.period}
        </div>
        <div class="timeline-middle">
          <div class="w-2.5 h-2.5 rounded-full bg-primary/40 border-2 border-primary"></div>
        </div>
        <div class="timeline-end timeline-box border border-base-300 shadow-sm bg-base-100">
          <h3 class="font-bold text-base-content">{item.institution}</h3>
          {item.description && (
            <p class="text-sm text-base-content/80 mt-1">{item.description}</p>
          )}
        </div>
        {i < academicHistory.length - 1 && <hr />}
      </li>
    ))}
  </ul>
</section>
