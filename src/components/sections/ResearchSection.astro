---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { research } from '@/data/research';
---

<section>
  <SectionHeader icon="science" title="Research" color="yellow" />
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body py-4 gap-3">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 rounded-full bg-base-content/25 shrink-0"></div>
        <h3 class="font-bold text-base-content">研究分野</h3>
      </div>
      <div class="flex flex-wrap gap-2 pl-5">
        {research.fields.map((field) => (
          <span class="badge bg-base-200 border-base-300 text-base-content">{field}</span>
        ))}
      </div>
      {research.interests && research.interests.length > 0 && (
        <p class="text-xs text-base-content/60 pl-5">
          その他関心のある分野:{research.interests.map((interest, i) => (
            <span><span class="whitespace-nowrap">{interest}</span>{i < research.interests!.length - 1 && '・'}</span>
          ))}
        </p>
      )}
    </div>
  </div>
</section>
