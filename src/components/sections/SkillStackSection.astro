---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import SkillCard from '@/components/ui/SkillCard.astro';
import { skillStack } from '@/data/skills';
---

<section>
  <SectionHeader icon="layers" title="Technical Skill Stack" />
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {skillStack.map((skill) => (
      <SkillCard skill={skill} />
    ))}
  </div>
  <div class="mt-6 p-3 bg-base-200 rounded-box border border-base-300 text-xs text-base-content flex flex-wrap gap-4">
    <span>★★★ : 成果物を一から作成できる</span>
    <span>★★ : 基本的な使い方を抑えている</span>
    <span>★ : 少し触ったことがある</span>
  </div>
</section>
