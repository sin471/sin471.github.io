---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { achievements } from '@/data/achievements';

if (achievements.length === 0) {
  return;
}
---

<section>
  <SectionHeader icon="emoji_events" title="Achievements" color="green" />
  <div class="space-y-4">
    {achievements.map((achievement) => (
      <div class="bg-slate-900/40 border border-slate-800 rounded-2xl p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-2 h-2 rounded-full bg-green-500 shadow-lg shadow-green-500/50"></div>
              <h3 class="font-bold text-white text-base">{achievement.title}</h3>
            </div>
            <p class="text-sm text-slate-300 pl-5">{achievement.description}</p>
            {achievement.date && (
              <p class="text-xs text-slate-400 pl-5 mt-2">{achievement.date}</p>
            )}
          </div>
          {achievement.url && (
            <a
              href={achievement.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-green-400 transition-colors shrink-0"
            >
              <span class="material-symbols-outlined text-sm leading-none">open_in_new</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
