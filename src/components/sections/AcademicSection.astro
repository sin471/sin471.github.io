---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { academicHistory } from '@/data/academic';
---

<section>
  <SectionHeader icon="school" title="Academic" color="yellow" />
  <div class="space-y-6">
    {academicHistory.map((item) => (
      <div class="bg-slate-900/40 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-2 h-2 rounded-full bg-yellow-500 shadow-lg shadow-yellow-500/50"></div>
          <h3 class="text-white font-bold text-lg">{item.institution}</h3>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed pl-5">{item.description}</p>
      </div>
    ))}
  </div>
</section>
