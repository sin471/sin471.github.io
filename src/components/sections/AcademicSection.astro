---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { academicHistory } from '@/data/academic';
---

<section>
  <SectionHeader icon="school" title="Academic" color="yellow" />
  <div class="space-y-4">
    {academicHistory.map((item) => (
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body py-4 gap-2">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-base-content/25 shrink-0"></div>
            <h3 class="font-bold text-base-content">{item.institution}</h3>
          </div>
          <p class="text-base text-base-content pl-5">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
