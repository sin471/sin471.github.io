---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { profile } from '@/data/profile';
---

<section>
  <SectionHeader icon="person" title="About" color="slate" />
  <p class="font-bold text-lg text-base-content mb-4">
    {profile.name.ja}<span class="text-base-content/50 font-normal text-sm ml-3">{profile.name.en}</span>
  </p>
  <div class="space-y-3 text-base text-base-content leading-relaxed [&_a]:text-blue-700 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-blue-900" set:html={profile.bio} />
</section>
