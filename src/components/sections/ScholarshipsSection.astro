---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { scholarships } from '@/data/scholarships';

if (scholarships.length === 0) {
  return;
}
---

<section>
  <SectionHeader icon="school" title="Scholarships" color="blue" />
  <div class="space-y-3">
    {scholarships.map((s) => (
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body py-4 gap-2">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <div class="w-2 h-2 rounded-full bg-base-content/25 shrink-0"></div>
                <h3 class="font-bold text-base-content">{s.title}</h3>
              </div>
              {s.description && <p class="text-base text-base-content pl-5">{s.description}</p>}
              <div class="flex gap-4 pl-5 mt-1">
                <p class="text-xs text-base-content/60">{s.period}</p>
                {s.amount && <p class="text-xs text-base-content/60">{s.amount}</p>}
              </div>
            </div>
            {s.url && (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                class="btn btn-ghost btn-xs shrink-0">
                <span class="material-symbols-outlined text-sm">open_in_new</span>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
