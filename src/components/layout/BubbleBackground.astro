---
// 泡を Canvas で描く全ページ共通の背景レイヤー（挙動は src/scripts/ocean/bubbles.ts）
---

<canvas
  id="bubble-canvas"
  class="fixed inset-0 pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  import { startBubbleField } from '@/scripts/ocean/bubbles'
  import { prefersReducedMotion, toggleDeepSea } from '@/scripts/ocean/shared'
  import { createSequenceMatcher, KONAMI } from '@/utils/sequence'

  // コナミコマンド → 深海モード（テーマ切替なのでモーション設定に関係なく有効）
  const konami = createSequenceMatcher(KONAMI, toggleDeepSea)
  window.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return
    konami.push(e.key)
  })

  const canvas = document.getElementById('bubble-canvas') as HTMLCanvasElement | null
  if (canvas && !prefersReducedMotion()) {
    startBubbleField(canvas)
  }
</script>
