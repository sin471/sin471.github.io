---
import Layout from '@/layouts/Layout.astro';
import ProfileSection from '@/components/sections/ProfileSection.astro';
import AccountLinksSection from '@/components/sections/AccountLinksSection.astro';
import SkillStackSection from '@/components/sections/SkillStackSection.astro';
import WorksSection from '@/components/sections/WorksSection.astro';
import ActivitiesSection from '@/components/sections/ActivitiesSection.astro';
import AcademicSection from '@/components/sections/AcademicSection.astro';
import CareerSection from '@/components/sections/CareerSection.astro';
import AchievementsSection from '@/components/sections/AchievementsSection.astro';
import CertificationsSection from '@/components/sections/CertificationsSection.astro';
import Footer from '@/components/layout/Footer.astro';
---

<Layout>
  <main class="p-6 md:p-20">
    <div class="max-w-5xl mx-auto space-y-32">
      <ProfileSection />
      <AccountLinksSection />
      <SkillStackSection />
      <WorksSection />
      <ActivitiesSection />
      <AcademicSection />
      <CareerSection />
      <AchievementsSection />
      <CertificationsSection />
      <Footer />
    </div>
  </main>
</Layout>
